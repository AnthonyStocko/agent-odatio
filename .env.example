# Copie ce fichier en .env. Il n'est jamais lu par l'agent lui-même, ni versionné.

# Claude : clé API de l'organisation. Vide = compte Claude Code connecté sur le poste (claude /login).
ANTHROPIC_API_KEY=

# Jeton HTTP Bitbucket (lecture), pour cloner les dépôts des profils
BITBUCKET_HTTP_TOKEN=

# Mots de passe des bases, un par profil (nom choisi dans mot_de_passe_env de profils.toml)
LOCAL_DB_PASSWORD=
RECETTE_X_DB_PASSWORD=

# groundcover (si un profil a un groundcover_filtre)
GROUNDCOVER_API_KEY=
GROUNDCOVER_BACKEND_ID=
GROUNDCOVER_API_URL=
