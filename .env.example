# Secrets et accès, renseignés de préférence depuis l'onglet Configuration de l'IHM.
# Ce fichier n'est jamais lu par l'agent lui-même, ni versionné.

# Compte Claude : "compte" (abonnement connecté dans CLAUDE_CONFIG_DIR) ou "cle" (ANTHROPIC_API_KEY)
CLAUDE_AUTH=compte
CLAUDE_CONFIG_DIR=
ANTHROPIC_API_KEY=

# Jira (lecture seule), pour charger une tâche à tester
JIRA_DOMAIN=savoye.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# Bitbucket Server / Data Center (lecture) : clonage des dépôts des projets et outils bitbucket_* de l'agent
BITBUCKET_HTTP_TOKEN=
# Adresse du serveur (facultatif : déduite des dépôts des projets), ex. https://git.kiscloud.io
BITBUCKET_URL=
# Clés des projets que l'agent peut lire, séparées par des virgules (vide = tous ceux lisibles avec le jeton)
BITBUCKET_PROJETS=

# groundcover (si un projet a un filtre groundcover)
GROUNDCOVER_API_KEY=
GROUNDCOVER_BACKEND_ID=
GROUNDCOVER_API_URL=

# Voix des vidéos de documentation : auto (Piper si installé, sinon Windows), piper (voix neuronale locale),
# edge (voix en ligne de Microsoft, la plus naturelle : le texte lu est envoyé à Microsoft), windows, aucune
DOCUMENTATION_VOIX=auto
# Nom de la voix : fr_FR-siwis-medium, fr_FR-tom-medium (Piper) ; fr-FR-DeniseNeural, fr-FR-HenriNeural (Edge)
DOCUMENTATION_VOIX_NOM=
# Modèle Piper déposé à la main (chemin du .onnx, avec son .onnx.json à côté), si le téléchargement est bloqué
DOCUMENTATION_VOIX_MODELE=
# Navigateur des captures d'écran : vide = Edge, sinon Chrome, sinon le Chromium de Playwright
NAVIGATEUR_CHEMIN=

# Mots de passe des comptes applicatifs (captures d'écran) : APP_PASSWORD_<PROFIL>
# Mots de passe des bases : DB_PASSWORD_<PROJET>, écrits par l'onglet Configuration
# (ou nom libre désigné par mot_de_passe_env dans profils.toml)
